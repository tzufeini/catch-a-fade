{
  "appId": "com.catchafade.app",
  "appName": "Catch a Fade",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0C0C0F"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0C0C0F",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
